# TestWeaver 環境變數範例
# 用法：cp .env.example .env  →  填入下方金鑰  →  docker compose up --build
# docker compose 會自動讀取同目錄的 .env 做變數插入。

# ── Embedding（RAG 索引/檢索「必填」，否則 index/query 會報錯）──
EMBEDDING_API_KEY=sk-your-key-here
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# ── LLM 答案（可選；未填則 /rag/query/async 回 fallback 字串）──
# LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── 認證 / JWT（FR-5 / M8；預設關閉，關閉時免登入、角色門檻放過）──
# 啟用後 /auth/* 以外皆需 Bearer token；/platform/* 另需 admin 角色
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60        # access token 效期（分）
REFRESH_TOKEN_DAYS=7          # refresh token 效期（天；可登出撤銷 / 旋轉）
# 首次啟動自動建立的 admin（僅帳號不存在時建立）
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin123

# 稽核日誌：記錄登入與狀態變更（POST/PATCH/DELETE），admin 可於 /audit/logs 檢視
AUDIT_ENABLED=false

# 報表匯出（FR-4 延伸）：PDF + Email
# PDF 字型（選填）：指向含繁體中文的 TTF 路徑可改善中文字顯示；留空用 reportlab 內建 CID 字型
PDF_FONT=
# Email（SMTP）：設 SMTP_HOST 才啟用；未設時 POST /reports/{id}/send 回 503
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_STARTTLS=true
